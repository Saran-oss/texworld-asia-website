# Form backend / email provider
# Configure one of the following before enabling actual delivery:
# - Email API (e.g. Resend / SendGrid / Mailgun)
# - Serverless form endpoint (e.g. Formspree / Basin / Netlify Forms)
# - Custom server endpoint (e.g. /api/enquiry)

# Example variable names — replace values with real secrets in hosting:
# .env.local (never commit real values)

VITE_FORM_ENDPOINT=
VITE_FORM_PROVIDER=

# Supabase example (optional — only if Supabase is used)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics / Plausible (optional)
VITE_ANALYTICS_DOMAIN=
